# Bridge fee estimation for Step 4.
# In the LI.FI special mode below, the code derives the base URL from this
# field, resolves the correct USDC token addresses for each chain, and computes
# the fee as (fromAmount - toAmount) / 10^decimals.
ARB_BRIDGE_FEE_URL_TEMPLATE=https://li.quest/v1/quote?fromChain={buy_chain}&toChain={sell_chain}&fromToken=USDC&toToken=USDC&fromAddress=0x000000000000000000000000000000000000dEaD&toAddress=0x000000000000000000000000000000000000dEaD&fromAmount={volume:.0f}000000
ARB_BRIDGE_FEE_JSON_PATH=__LIFI_SAME_TOKEN_FEE_USD__

# Execution settings for Step 5.
